{
  "name": "ssh-inspector-mcp",
  "version": "0.1.0",
  "description": "RHELホストを安全に参照するstdio MCPサーバー",
  "type": "module",
  "private": true,
  "bin": {
    "ssh-inspector-mcp": "./dist/ssh-inspector.mjs"
  },
  "files": [
    "dist/ssh-inspector.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "lint": "eslint .",
    "start": "node dist/ssh-inspector.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ssh2": "1.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/ssh2": "1.15.5",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "64.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}