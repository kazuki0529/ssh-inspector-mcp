{
  "ssh": {
    "host": "rhel.example.internal",
    "port": 22,
    "username": "inspector",
    "hostKeySha256": "SHA256:REPLACE_WITH_43_CHARACTER_BASE64_VALUE",
    "authentication": {
      "method": "privateKey",
      "privateKeyPath": "/home/user/.ssh/id_ed25519"
    }
  },
  "access": {
    "allowedListRoots": ["/var/log", "/etc"],
    "allowedReadRoots": ["/var/log/application"],
    "allowedSystemdUnits": ["application.service"]
  },
  "aws": {
    "allowedRegions": ["ap-northeast-1"],
    "s3": [
      {
        "bucket": "example-observability",
        "prefixes": ["logs/"],
        "allowObjectContent": false
      }
    ],
    "dynamodb": [
      {
        "table": "example-status",
        "indexes": [],
        "allowItemData": false
      }
    ]
  }
}